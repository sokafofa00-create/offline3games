{
	"name": "Red TradeOff",
	"descriptions": "RedTradeOff",
	"powers": [
		{
			"event": "Game Start",
			"seat": "All",
			"effects": [
				{
					"name": "Get Weekly Status Node",
					"output": "weekly_node"
				},
				{
					"name": "Count Monsters By Tile Type",
					"seat": "Self",
					"tileType": "Red",
					"output": "red_count"
				},
				{
					"name": "Is Greater Than",
					"a": "$red_count",
					"b": 0,
					"output": "has_red"
				},
				{
					"name": "If",
					"case": "$has_red",
					"effects": [
						{
							"name": "Get Monsters By Tile Type",
							"seat": "Self",
							"tileType": "Red",
							"output": "red_monsters"
						},
						{
							"name": "Get Monsters Except Tile Type",
							"seat": "Self",
							"tileType": "Red",
							"output": "other_monsters"
						},
						{
							"name": "For",
							"list": "$red_monsters",
							"iterator": "red_monster",
							"effects": [
								{
									"name": "Set Permanent Buff",
									"entity": "$red_monster",
									"buffType": "BUFF_ATK",
									"value": 5
								}
							]
						},
						{
							"name": "For",
							"list": "$other_monsters",
							"iterator": "other_monster",
							"effects": [
								{
									"name": "Set Permanent Buff",
									"entity": "$other_monster",
									"buffType": "BUFF_MANA",
									"value": 1
								}
							]
						},
						{
							"name": "For",
							"list": "$red_monsters",
							"iterator": "red_monster",
							"effects": [
								{
									"name": "Spawn Rocket",
									"start": "$weekly_node",
									"end": "$red_monster",
									"seconds": 0.4,
									"insideColor": "Purple",
									"outsideColor": "Red",
									"scale": 1
								}
							]
						},
						{
							"name": "For",
							"list": "$other_monsters",
							"iterator": "other_monster",
							"effects": [
								{
									"name": "Spawn Rocket",
									"start": "$weekly_node",
									"end": "$other_monster",
									"seconds": 0.4,
									"insideColor": "Gray",
									"outsideColor": "Red",
									"scale": 1
								}
							]
						},
						{
							"name": "Wait",
							"seconds": 0.4
						},
						{
							"name": "For",
							"list": "$red_monsters",
							"iterator": "red_monster",
							"effects": [
								{
									"name": "Spawn Puff",
									"node": "$red_monster",
									"color": "Red",
									"size": 0.01
								},
								{
									"name": "Show Permanent Buff",
									"entity": "$red_monster",
									"buffType": "BUFF_ATK"
								}
							]
						},
						{
							"name": "For",
							"list": "$other_monsters",
							"iterator": "other_monster",
							"effects": [
								{
									"name": "Spawn Puff",
									"node": "$other_monster",
									"color": "Gray",
									"size": 0.01
								},
								{
									"name": "Show Mana Buff",
									"entity": "$other_monster",
									"value": true
								}
							]
						}
					]
				}
			]
		}
	]
}
