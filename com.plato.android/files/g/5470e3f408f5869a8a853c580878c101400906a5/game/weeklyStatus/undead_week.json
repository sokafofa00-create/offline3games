{
	"name": "Undead Week",
	"descriptions": "UndeadWeek",
	"powers": [
		{
			"event": "Game Start",
			"seat": "All",
			"effects": [
				{
					"name": "Get Weekly Status Node",
					"output": "weekly_node"
				},
			    {
					"name": "Count Monsters By Tag",
					"seat": "Self",
					"tag": "undead",
					"output": "undead_count"
				},
				{
					"name": "Is Equal To",
					"a": "$undead_count",
					"b": 1,
					"output": "has_one_undead_monster"
				},
                {
					"name": "Is Greater Than",
					"a": "$undead_count",
					"b": 1,
					"output": "has_two_undead_monster"
				},
				{
					"name": "If",
					"case": "$has_one_undead_monster",
					"effects": [
						{
							"name": "Get Monsters By Tag",
							"seat": "Self",
							"tag": "undead",
							"output": "undead_monsters"
						},
						{
							"name": "Get Monsters Except Tag",
							"seat": "Self",
							"tag": "undead",
							"output": "other_monsters"
						},
						{
							"name": "For",
							"list": "$undead_monsters",
							"iterator": "undead_monster",
							"effects": [
								{
									"name": "Set Permanent Buff",
									"entity": "$undead_monster",
									"buffType": "BUFF_ATK",
									"value": 1
								}
							]
						},
						{
							"name": "For",
							"list": "$undead_monsters",
							"iterator": "undead_monster",
							"effects": [
								{
									"name": "Spawn Rocket",
									"start": "$weekly_node",
									"end": "$undead_monster",
									"seconds": 0.4,
									"insideColor": "Purple",
									"outsideColor": "Red",
									"scale": 1
								}
							]
						},
						{
							"name": "Wait",
							"seconds": 0.4
						},
						{
							"name": "For",
							"list": "$undead_monsters",
							"iterator": "undead_monster",
							"effects": [
								{
									"name": "Spawn Puff",
									"node": "$undead_monster",
									"color": "Red",
									"size": 0.01
								},
								{
									"name": "Show Permanent Buff",
									"entity": "$undead_monster",
									"buffType": "BUFF_ATK"
								}
							]
						},
	                    {
                            "name": "Get Player Node",
                            "seat": "Self",
                            "output": "player_node"
                        },
                        {
                            "name": "Spawn Rocket",
                            "start": "$weekly_node",
                            "end": "$player_node",
                            "seconds": 0.4,
                            "insideColor": "Purple",
                            "outsideColor": "Red",
                            "scale": 1
                        },
                        {
                            "name": "Wait",
                            "seconds": 0.4
                        },
                        {
                            "name": "Spawn Puff",
                            "node": "$player_node",
                            "color": "Red",
                            "size": 0.01
                        },
                        {
                            "name": "Increase Player Max Life",
                            "seat": "Self",
                            "value": -2
                        }
					]
				},
                {
					"name": "If",
					"case": "$has_two_undead_monster",
					"effects": [
						{
							"name": "Get Monsters By Tag",
							"seat": "Self",
							"tag": "undead",
							"output": "undead_monsters"
						},
						{
							"name": "For",
							"list": "$undead_monsters",
							"iterator": "undead_monster",
							"effects": [
								{
									"name": "Set Permanent Buff",
									"entity": "$undead_monster",
									"buffType": "BUFF_ATK",
									"value": 1
								}
							]
						},
						{
							"name": "For",
							"list": "$undead_monsters",
							"iterator": "undead_monster",
							"effects": [
								{
									"name": "Spawn Rocket",
									"start": "$weekly_node",
									"end": "$undead_monster",
									"seconds": 0.4,
									"insideColor": "Purple",
									"outsideColor": "Red",
									"scale": 1
								}
							]
						},
						{
							"name": "Wait",
							"seconds": 0.4
						},
						{
							"name": "For",
							"list": "$undead_monsters",
							"iterator": "undead_monster",
							"effects": [
								{
									"name": "Spawn Puff",
									"node": "$undead_monster",
									"color": "Red",
									"size": 0.01
								},
								{
									"name": "Show Permanent Buff",
									"entity": "$undead_monster",
									"buffType": "BUFF_ATK"
								}
							]
						},
						{
                            "name": "Get Player Node",
                            "seat": "Self",
                            "output": "player_node"
                        },
                        {
                            "name": "Spawn Rocket",
                            "start": "$weekly_node",
                            "end": "$player_node",
                            "seconds": 0.4,
                            "insideColor": "Purple",
                            "outsideColor": "Red",
                            "scale": 1
                        },
                        {
                            "name": "Wait",
                            "seconds": 0.4
                        },
                        {
                            "name": "Spawn Puff",
                            "node": "$player_node",
                            "color": "Red",
                            "size": 0.01
                        },
                        {
                            "name": "Increase Player Max Life",
                            "seat": "Self",
                            "value": -4
                        }
					]
				}
			]
		}
	]
}
