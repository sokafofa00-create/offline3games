                        },
                        {
                            "name": "Spawn Rocket",
                            "start": "$weekly_node",
                            "end": "$player_node",
                            "seconds": 0.4,
                            "insideColor": "Purple",
                            "outsideColor": "Red",
                            "scale": 1
                        },
                        {
                            "name": "Wait",
                            "seconds": 0.4
                        },
                        {
                            "name": "Spawn Puff",
                            "node": "$player_node",
                            "color": "Red",
                            "size": 0.01
                        },
                        {
                            "name": "Increase Player Max Life",
                            "seat": "Self",
                            "value": -10
                        }
					]
				}
			]
		}
	]
}
