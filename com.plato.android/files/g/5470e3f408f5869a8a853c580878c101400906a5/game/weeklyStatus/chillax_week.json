{
	"name": "Chillax Week",
	"descriptions": "ChillaxWeek",
	"powers": [
		{
			"event": "Game Start",
			"seat": "All",
			"effects": [
				{
					"name": "Get Weekly Status Node",
					"output": "weekly_node"
				},
			    {
					"name": "Count Monsters By Tag",
					"seat": "Self",
					"tag": "chillax",
					"output": "chillax_count"
				},
                {
					"name": "Is Greater Than",
					"a": "$chillax_count",
					"b": 0,
					"output": "has_chillax_monster"
				},
				{
					"name": "If",
					"case": "$has_chillax_monster",
					"effects": [
	                    {
                            "name": "Get Player Node",
                            "seat": "Self",
                            "output": "player_node"
                        },
                        {
                            "name": "Spawn Rocket",
                            "start": "$weekly_node",
                            "end": "$player_node",
                            "seconds": 0.4,
                            "insideColor": "Purple",
                            "outsideColor": "Red",
                            "scale": 1
                        },
                        {
                            "name": "Wait",
                            "seconds": 0.4
                        },
                        {
                            "name": "Spawn Puff",
                            "node": "$player_node",
                            "color": "Red",
                            "size": 0.01
                        },
						{
							"name": "Update Player Berries",
							"seat": "Self",
							"change": 1
						},
						{
                            "name": "Wait",
                            "seconds": 0.4
                        },
						{
                            "name": "Spawn Rocket",
                            "start": "$weekly_node",
                            "end": "$player_node",
                            "seconds": 0.4,
                            "insideColor": "Purple",
                            "outsideColor": "Red",
                            "scale": 1
                        },
						{
                            "name": "Wait",
                            "seconds": 0.4
                        },
                        {
                            "name": "Spawn Puff",
                            "node": "$player_node",
                            "color": "Red",
                            "size": 0.01
                        },
                        {
                            "name": "Increase Player Max Life",
                            "seat": "Self",
                            "value": -2
                        }
					]
				}
			]
		}
	]
}
