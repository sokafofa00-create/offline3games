{
	"name": "All Color Boost",
	"descriptions": "AllColorBoost",
	"powers": [
		{
			"event": "Game Start",
			"seat": "All",
			"effects": [
				{
					"name": "Get Weekly Status Node",
					"output": "weekly_node"
				},

				{
					"name": "Get Monsters By Tile Type",
					"seat": "Self",
					"tileType": "Red",
					"output": "red_monsters"
				},
				{
					"name": "For",
					"list": "$red_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Set Permanent Buff",
							"entity": "$m",
							"buffType": "BUFF_MANA",
							"value": -1
						}
					]
				},

				{
					"name": "Get Monsters By Tile Type",
					"seat": "Self",
					"tileType": "Blue",
					"output": "blue_monsters"
				},
				{
					"name": "For",
					"list": "$blue_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Set Permanent Buff",
							"entity": "$m",
							"buffType": "BUFF_ATK",
							"value": 5
						}
					]
				},

				{
					"name": "Get Monsters By Tile Type",
					"seat": "Self",
					"tileType": "Green",
					"output": "green_monsters"
				},
				{
					"name": "Get List Length",
					"list": "$green_monsters",
					"output": "green_count"
				},
				{
					"name": "Is Greater Than",
					"a": "$green_count",
					"b": 0,
					"output": "has_green"
				},
				{
					"name": "If",
					"case": "$has_green",
					"effects": [
						{
							"name": "Increase Player Max Life",
							"seat": "Self",
							"value": 10
						}
					]
				},

				{
					"name": "Get Monsters By Tile Type",
					"seat": "Self",
					"tileType": "Yellow",
					"output": "yellow_monsters"
				},
				{
					"name": "For",
					"list": "$yellow_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Set Permanent Buff",
							"entity": "$m",
							"buffType": "BUFF_ATK",
							"value": 10
						},
						{
							"name": "Set Permanent Buff",
							"entity": "$m",
							"buffType": "BUFF_MANA",
							"value": 1
						}
					]
				},

				{
					"name": "Count Monsters By Tile Type",
					"seat": "Self",
					"tileType": "Purple",
					"output": "purple_count"
				},
				{
					"name": "Is Greater Than",
					"a": "$purple_count",
					"b": 0,
					"output": "has_purple"
				},
				{
					"name": "For",
					"list": "$red_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Spawn Rocket",
							"start": "$weekly_node",
							"end": "$m",
							"seconds": 0.4,
							"insideColor": "Purple",
							"outsideColor": "Red",
							"scale": 1
						}
					]
				},
				{
					"name": "For",
					"list": "$blue_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Spawn Rocket",
							"start": "$weekly_node",
							"end": "$m",
							"seconds": 0.4,
							"insideColor": "Purple",
							"outsideColor": "Blue",
							"scale": 1
						}
					]
				},
				{
					"name": "If",
					"case": "$has_green",
					"effects": [
						{
							"name": "Get Player Node",
							"seat": "Self",
							"output": "player_node"
						},
						{
							"name": "Spawn Rocket",
							"start": "$weekly_node",
							"end": "$player_node",
							"seconds": 0.4,
							"insideColor": "Purple",
							"outsideColor": "Green",
							"scale": 1
						}
					]
				},
				{
					"name": "For",
					"list": "$yellow_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Spawn Rocket",
							"start": "$weekly_node",
							"end": "$m",
							"seconds": 0.4,
							"insideColor": "Purple",
							"outsideColor": "Yellow",
							"scale": 1
						}
					]
				},
				{
					"name": "If",
					"case": "$has_purple",
					"effects": [
						{
							"name": "Get Player Node",
							"seat": "Self",
							"output": "player_node_p"
						},
						{
							"name": "Spawn Rocket",
							"start": "$weekly_node",
							"end": "$player_node_p",
							"seconds": 0.4,
							"insideColor": "Purple",
							"outsideColor": "Purple",
							"scale": 1
						}
					]
				},

				{
					"name": "Wait",
					"seconds": 0.4
				},

				{
					"name": "For",
					"list": "$red_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Spawn Puff",
							"node": "$m",
							"color": "Red",
							"size": 0.01
						},
						{
							"name": "Show Mana Buff",
							"entity": "$m",
							"value": true
						}
					]
				},
				{
					"name": "For",
					"list": "$blue_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Spawn Puff",
							"node": "$m",
							"color": "Blue",
							"size": 0.01
						},
						{
							"name": "Show Permanent Buff",
							"entity": "$m",
							"buffType": "BUFF_ATK"
						}
					]
				},
				{
					"name": "For",
					"list": "$yellow_monsters",
					"iterator": "m",
					"effects": [
						{
							"name": "Spawn Puff",
							"node": "$m",
							"color": "Yellow",
							"size": 0.01
						},
						{
							"name": "Show Mana Buff",
							"entity": "$m",
							"value": true
						},
						{
							"name": "Show Permanent Buff",
							"entity": "$m",
							"buffType": "BUFF_ATK"
						}
					]
				},
				{
					"name": "If",
					"case": "$has_purple",
					"effects": [
						{
							"name": "Update Player Berries",
							"seat": "Self",
							"change": 1
						}
					]
				}
			]
		}
	]
}
