{
	"name": "Blue TradeOff",
	"descriptions": "BlueTradeOff",
	"powers": [
		{
			"event": "Game Start",
			"seat": "All",
			"effects": [
				{
					"name": "Get Weekly Status Node",
					"output": "weekly_node"
				},
				{
					"name": "Count Monsters By Tile Type",
					"seat": "Self",
					"tileType": "Blue",
					"output": "blue_count"
				},
				{
					"name": "Is Greater Than",
					"a": "$blue_count",
					"b": 0,
					"output": "has_blue"
				},
				{
					"name": "If",
					"case": "$has_blue",
					"effects": [
						{
							"name": "Get Monsters By Tile Type",
							"seat": "Self",
							"tileType": "Blue",
							"output": "blue_monsters"
						},
						{
							"name": "Get Monsters Except Tile Type",
							"seat": "Self",
							"tileType": "Blue",
							"output": "other_monsters"
						},
						{
							"name": "For",
							"list": "$blue_monsters",
							"iterator": "blue_monster",
							"effects": [
								{
									"name": "Set Initial Mana",
									"entity": "$blue_monster",
									"value": 3
								}
							]
						},
						{
							"name": "For",
							"list": "$other_monsters",
							"iterator": "other_monster",
							"effects": [
								{
									"name": "Set Permanent Buff",
									"entity": "$other_monster",
									"buffType": "BUFF_ATK",
									"value": -1
								}
							]
						},
						{
							"name": "For",
							"list": "$blue_monsters",
							"iterator": "blue_monster",
							"effects": [
								{
									"name": "Spawn Rocket",
									"start": "$weekly_node",
									"end": "$blue_monster",
									"seconds": 0.4,
									"insideColor": "Purple",
									"outsideColor": "Blue",
									"scale": 1
								}
							]
						},
						{
							"name": "For",
							"list": "$other_monsters",
							"iterator": "other_monster",
							"effects": [
								{
									"name": "Spawn Rocket",
									"start": "$weekly_node",
									"end": "$other_monster",
									"seconds": 0.4,
									"insideColor": "Gray",
									"outsideColor": "Blue",
									"scale": 1
								}
							]
						},
						{
							"name": "Wait",
							"seconds": 0.4
						},
						{
							"name": "For",
							"list": "$blue_monsters",
							"iterator": "blue_monster",
							"effects": [
								{
									"name": "Spawn Puff",
									"node": "$blue_monster",
									"color": "Blue",
									"size": 0.01
								},
								{
									"name": "Set Initial Mana",
									"entity": "$blue_monster",
									"value": 3
								}
							]
						},
						{
							"name": "For",
							"list": "$other_monsters",
							"iterator": "other_monster",
							"effects": [
								{
									"name": "Spawn Puff",
									"node": "$other_monster",
									"color": "Gray",
									"size": 0.01
								},
								{
									"name": "Show Permanent Buff",
									"entity": "$other_monster",
									"buffType": "BUFF_ATK"
								}
							]
						}
					]
				}
			]
		}
	]
}
