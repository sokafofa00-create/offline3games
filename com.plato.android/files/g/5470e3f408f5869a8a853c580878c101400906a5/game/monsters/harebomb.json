                    "effects": [
                        {
                            "name": "Harvest Tiles",
                            "tiles": "$blue_tiles"
                        }
                    ]
                },
                {
                    "name": "Else",
                    "case": "$harvest_blue_tiles",
                    "effects": [
                        {
                            "name": "Get Random Tiles",
                            "w": 1,
                            "h": 1,
                            "amount": 3,
                            "exclude": [
                                "Blue",
                                "Bomb"
                            ],
                            "output": "tiles_to_convert"
                        },
                        {
                            "name": "Convert Tiles",
                            "tiles": "$tiles_to_convert",
                            "type": "Blue"
                        }
                    ]
                }
