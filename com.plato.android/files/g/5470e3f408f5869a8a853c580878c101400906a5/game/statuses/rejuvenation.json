{
	"name": "Rejuvenation",
	"icon_sprite": "~/images/statuses/regen.webp",
	"powers": [
		{
			"event": "Turn End",
			"seat": "Self",
			"effects": [
				{
					"name": "Heal",
					"seat": "Self",
					"health": 5
				},
				{
					"name": "Get Player Status Charges",
					"seat": "Self",
					"status": "Rejuvenation",
					"output": "charges"
				},
				{
					"name": "Subtract",
					"a": "$charges",
					"b": 1,
					"output": "final_charges"
				},
				{
					"name": "Update Player Status",
					"seat": "Self",
					"status": "Rejuvenation",
					"charges": "$final_charges"
				},
                {
					"name": "Is Equal To",
					"a": "$final_charges",
					"b": 0,
					"output": "is_zero"
				},
                {
					"name": "If",
					"case": "$is_zero",
					"effects": [
						{
							"name": "Remove Player Status",
							"seat": "Self",
							"status": "Rejuvenation"
						}
                    ]
                }

			]
		}
    ]
}