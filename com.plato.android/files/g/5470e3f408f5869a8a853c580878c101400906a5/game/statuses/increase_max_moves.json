{
	"name": "Increase Max Moves",
	"icon_sprite": "~/images/statuses/add_bonus_move.webp",
	"powers": [
		{
			"event": "Turn Start",
			"seat": "Self",
			"effects": [
				{
					"name": "Increase Max Moves",
					"amount": 1
				},
				{
					"name": "Get Player Status Charges",
					"seat": "Self",
					"status": "Increase Max Moves",
					"output": "starting_charges"
				},
				{
					"name": "Is Equal To",
					"a": "$starting_charges",
					"b": 1,
					"output": "has_one_charge"
				},
				{
					"name": "Switch",
					"input": "$has_one_charge",
					"cases": [
						{
							"case": true,
							"effects": [
								{
									"name": "Remove Player Status",
									"seat": "Self",
									"status": "Increase Max Moves"
								}
							]
						},
						{
							"case": false,
							"effects": [
								{
									"name": "Subtract",
									"a": "$starting_charges",
									"b": 1,
									"output": "final_charges"
								},
								{
									"name": "Update Player Status",
									"seat": "Self",
									"status": "Increase Max Moves",
									"charges": "$final_charges"
								}
							]
						}
					]
				}
			]
		}
	]
}